<?xml version="1.0" encoding="utf-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="OnRibbonLoad">
  <ribbon>
    <tabs>
      <!-- {TabIdMso} is TabNewMailMessage or TabInsert, chosen by TargetTab at startup. -->
      <tab idMso="{TabIdMso}">
        <group id="grpQuickAttach" getLabel="GetGroupLabel" insertAfterMso="GroupInclude">
          <dynamicMenu id="mnuFiles"
                     getLabel="GetGalleryLabel"
                     getScreentip="GetGalleryScreentip"
                     getEnabled="GetGalleryEnabled"
                     size="large" imageMso="AttachFile"
                     getContent="GetMenuContent" invalidateContentOnDrop="true"/>
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
